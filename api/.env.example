# production is also the DEFAULT, on purpose: a deploy that configures nothing is
# locked rather than open. Only a value of dev/development/local enables
# /auth/dev-login, which logs into any seeded account by name — admins included.
ENVIRONMENT=production
SECRET_KEY=generate-a-long-random-secret
PETITION_THRESHOLD=5
VOUCH_THRESHOLD=2
PROPOSAL_SECONDS_COORDINATION=3
PROPOSAL_SECONDS_PUNITIVE=5
PROPOSAL_WINDOW_HOURS=48
PROPOSAL_QUORUM=3
TELEGRAM_BOT_TOKEN=your-botfather-token
TELEGRAM_BOT_USERNAME=YourBotUsername

# --- Telegram DM push channel (app/telegram.py) ---
# An empty TELEGRAM_BOT_TOKEN already means "off" — that is what keeps dev and CI
# from ever reaching api.telegram.org. TELEGRAM_DM_ENABLED is the separate runtime
# kill switch for a deploy that has a token but wants DMs paused.
TELEGRAM_DM_ENABLED=true
# PUBLIC_WEB_URL must be set in production or every DM link is silently omitted,
# leaving the reader a message they cannot act on. Point it at the web origin.
PUBLIC_WEB_URL=https://mahalladosh.uz
# Defaults are sensible; override only if needed.
# TELEGRAM_API_BASE=https://api.telegram.org
# TELEGRAM_TIMEOUT_SECONDS=5
# TELEGRAM_DM_WORKERS=4

# DATABASE_URL=postgresql://user:pass@host/db  (defaults to local SQLite for dev)

# --- uploads ---
# Uploaded photos are written here. Leave empty and they land in api/uploads, which
# is INSIDE the application directory and so is wiped on every redeploy of a
# container — silently: the database rows keep pointing at files that no longer
# exist. Point this at a mounted volume for anything real.
UPLOAD_DIR=/var/data/uploads
# Set true only for a throwaway demo, to accept that loss and silence the startup
# warning. Never set it on an instance real families use.
UPLOADS_MAY_BE_EPHEMERAL=false

# --- schema ---
# Migrations are applied at startup. Correct for a single instance; set false and
# run `alembic upgrade head` as a release step once you run more than one, or they
# will race the same DDL.
RUN_MIGRATIONS_ON_START=true
